<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SwitchHandover.Desktop" x:Class="SwitchHandover.Desktop.MainWindow" x:DataType="vm:MainViewModel" Title="Switch Handover Generator" Width="1400" Height="900" MinWidth="1000" MinHeight="650">
<LayoutTransformControl><LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></LayoutTransformControl.LayoutTransform><Grid RowDefinitions="Auto,*,Auto" Margin="24">
<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16"><StackPanel><TextBlock Text="Switch Handover Generator" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Cisco switch and AP evidence · inventory · topology" Margin="0,5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Export Excel" Click="Excel" IsEnabled="{Binding !IsBusy}"/><Button Content="Port CSV" Click="Csv" IsEnabled="{Binding !IsBusy}"/><Button Content="Report ZIP" Click="Bundle" IsEnabled="{Binding !IsBusy}"/><Button Content="Export Visio" Click="Visio" IsEnabled="{Binding !IsBusy}"/><Button Content="Theme" Click="ToggleTheme"/></WrapPanel></Grid>
<Grid Grid.Row="1" ColumnDefinitions="310,16,*"><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="14" CornerRadius="8"><ScrollViewer><StackPanel Spacing="9" IsEnabled="{Binding !IsBusy}"><TextBlock Text="Site and evidence" FontSize="18" FontWeight="SemiBold"/><TextBox Text="{Binding Site}" Watermark="Site location (required)"/><ComboBox ItemsSource="{Binding LocationTypes}" SelectedItem="{Binding LocationType}" HorizontalAlignment="Stretch"/><TextBox Text="{Binding ManagementVlan}" Watermark="Management VLAN (optional)"/><TextBox Text="{Binding InputPaths}" Watermark="Capture files, folders or ZIP paths — one per line" Height="115" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><Button Content="Add files / ZIP" Click="Files"/><Button Content="Add folder" Click="Folder"/></WrapPanel><CheckBox Content="Include SFP inventory" IsChecked="{Binding IncludeSfps}"/><CheckBox Content="Include complete port config" IsChecked="{Binding IncludeAllPorts}"/><Button Content="Analyze captures" Click="Analyze"/><Expander Header="Live SSH capture"><StackPanel Spacing="8"><TextBox Text="{Binding Seed}" Watermark="Seed switch addresses"/><TextBox Text="{Binding Username}" Watermark="Username"/><TextBox Text="{Binding Password}" Watermark="Password" PasswordChar="●"/><TextBox Text="{Binding EnableSecret}" Watermark="Enable secret (optional)" PasswordChar="●"/><CheckBox Content="Traverse CDP neighbors" IsChecked="{Binding Traverse}"/><CheckBox Content="Capture APs" IsChecked="{Binding IncludeAps}"/><TextBox Text="{Binding SubnetFilter}" Watermark="Optional IPv4 CIDR or prefix"/><TextBlock Text="Parallel sessions / maximum hops"/><NumericUpDown Minimum="1" Maximum="32" Value="{Binding Workers}" FormatString="0"/><NumericUpDown Minimum="0" Maximum="32" Value="{Binding MaxHops}" FormatString="0"/><TextBox Text="{Binding CaptureDirectory}" Watermark="Capture output directory"/><Button Content="Capture and analyze" Click="Capture"/><Button Content="Export captured logs ZIP" Click="CapturesZip"/></StackPanel></Expander><TextBlock Text="Nothing connects automatically. Live capture is read-only and bounded to 512 devices; phones are excluded. Completed captures remain in the output directory after cancellation." FontSize="12" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
<Grid Grid.Column="2" RowDefinitions="Auto,*"><TextBox Text="{Binding Search}" Watermark="Filter reports by hostname, IP, interface or description" Margin="0,0,0,8"/><TabControl Grid.Row="1"><TabItem Header="Devices"><DataGrid ItemsSource="{Binding Switches}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Neighbor ports"><DataGrid ItemsSource="{Binding Ports}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="SFP inventory"><DataGrid ItemsSource="{Binding Sfps}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Complete port config"><DataGrid ItemsSource="{Binding AllPorts}" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem><TabItem Header="Topology"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,200"><Button Content="Reset automatic layout" Click="Reset" IsEnabled="{Binding !IsBusy}"/><Slider Grid.Column="1" Minimum="35" Maximum="140" Value="{Binding DiagramScale}"/></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsBusy}"><vm:TopologyCanvas Diagram="{Binding Diagram}" Graph="{Binding Graph}" Scale="{Binding DiagramScale}"/></ScrollViewer></Grid></TabItem><TabItem Header="Evidence log"><TextBox Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></TabItem></TabControl></Grid></Grid>
<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock Text="{Binding Status}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/><TextBlock Text="By Yash Nalawde" FontSize="11" VerticalAlignment="Center"/></StackPanel></Grid>
</Grid></LayoutTransformControl></Window>
